# =============================================================================
# Mithrava Backend — Railway Environment Variables
# =============================================================================
# Copy these into Railway service → Variables tab
#
# IMPORTANT: Railway auto-generates DATABASE_URL when you add a PostgreSQL
# database. You just need to override the driver prefix (see step below).
# =============================================================================

# ─── Database (auto-set by Railway PostgreSQL addon) ─────────────────────────
# Railway gives you: postgresql://user:pass@host:port/dbname
# Override it with the async driver:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string

# ─── CORS (your Vercel frontend URL) ────────────────────────────────────────
CORS_ORIGINS=https://mithrava-mvp.vercel.app

# ─── AI / LLM Keys (get from respective platforms) ──────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ─── Weather ─────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=...

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Firebase (optional — for push notifications) ───────────────────────────
# FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
