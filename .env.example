# ─── MITHRAVA - ENVIRONMENT VARIABLES ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Variables marked with [required] must be set before running.
# ────────────────────────────────────────────────────────────────────────────────

# ── Database [required] ──────────────────────────────────────────────────────
POSTGRES_DB=mithrava
POSTGRES_USER=mithrava
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here    # [required]

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here         # Optional, leave empty for no auth

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_random_64_char_string           # [required for production]
ENVIRONMENT=production
DEBUG=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# SMS_PROVIDER=console          # Options: console, twilio, msg91
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=MITHRA

# ── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here               # [required for Mitra AI]
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_URL=http://localhost:11434                     # Local Ollama (free)
OLLAMA_MODEL=llama3.1

# Google Gemini (free tier: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=your-gemini-api-key-here               # [required for voice features]

# ── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-key-here       # [required for weather]
# Backward-compat alias (deprecated): OPENWEATHERMAP_API_KEY

# ── Cloud Storage (optional) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=mithrava-storage
AWS_REGION=ap-south-1

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database Sync (for management scripts) ───────────────────────────────────
DATABASE_URL_SYNC=sqlite:///./mithrava.db

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Mithrava
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=10
RATE_LIMIT_WINDOW=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. In production, only set your actual domain(s).
CORS_ORIGINS=["http://localhost:3000"]

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
