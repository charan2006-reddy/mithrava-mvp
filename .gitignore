# =============================================================================
# Mithrava — .gitignore
# Python + Node.js + Docker + IDE + OS
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# mypy / ruff / pylint
.mypy_cache/
.ruff_cache/
.pylint.d/

# PyInstaller
*.spec

# ---------------------------------------------------------------------------
# Node.js / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.nuxt/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml
*.log

# ---------------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace
.cursor/
.cursorignore

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.example.*
!.env.prod.example
!.env.railway.example

# SSL certs
*.pem
*.key
*.crt
*.p12

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
hello-fly/
*.db
backend/mithrava.db
backend/app/uploads/*
!backend/app/uploads/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
*.pid
*.seed
media/
staticfiles/

# Database dumps
*.sql.gz
*.dump
backups/
