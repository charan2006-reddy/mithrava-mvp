# =============================================================================
# Mithrava Production Environment
# =============================================================================
# Copy this file to .env.prod and fill in the values.

# Database
POSTGRES_DB=mithrava
POSTGRES_USER=mithrava
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Security
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# CORS (comma-separated origins)
CORS_ORIGINS=https://mithrava.com,https://www.mithrava.com

# Google Gemini (primary LLM)
GEMINI_API_KEY=...

# Weather
OPENWEATHER_API_KEY=...
