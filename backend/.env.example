# Mithrava Agriculture Platform - Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mithrava

# JWT Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini (primary LLM — free tier: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenWeatherMap API
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_BASE_URL=http://localhost:8000/uploads

# S3 (for production)
# S3_BUCKET=mithrava-uploads
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
