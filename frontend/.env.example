# Mithrava Frontend - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in values.

# API Backend URL — used by Next.js rewrites to proxy /api/* to the backend
# For local dev: http://localhost:8000
# For production (Vercel): set NEXT_PUBLIC_API_URL in Vercel dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# App Info (optional — displayed in UI)
NEXT_PUBLIC_APP_NAME=Mithrava
NEXT_PUBLIC_APP_VERSION=1.0.0

# Dev server binding
HOSTNAME=0.0.0.0
PORT=3000
